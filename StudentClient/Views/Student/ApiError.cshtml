@{
    ViewData["Title"] = "Ошибка";
}
<!DOCTYPE html>
<html lang="ru">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Ошибка запроса</title></head>
<body style="font-family:Arial,sans-serif;max-width:700px;margin:50px auto;padding:0 18px">
    <h1>Не удалось выполнить запрос</h1>
    <p>@ViewBag.Error</p>
    @if (ViewBag.StatusCode != null && (int)ViewBag.StatusCode != 0) { <p>Код ответа сервера: @ViewBag.StatusCode</p> }
    <a asp-action="Index">Вернуться к списку студентов</a>
</body>
</html>
